# ============================================================
# Email / OTP Delivery Configuration
# Set these in your Render dashboard under "Environment"
#
# Option A: Gmail SMTP (Standard Mail Submission)
# Note: Render Free Web Services occasionally block ports 587/465.
# If so, use Option B (Brevo) which uses HTTPS Port 443 (100% unblockable).
# ============================================================
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_PORT=587

# Option B: Brevo (Sendinblue) HTTPS API (Recommended for Render Free Tier)
# Get free API key at https://app.brevo.com/settings/keys/api (300 free emails/day)
# Uses standard HTTPS port 443 — NEVER blocked by Render cloud firewall!
BREVO_API_KEY=

# Option C: Resend HTTPS API (Port 443)
RESEND_API_KEY=

ADMIN_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
DATABASE_POOL_MAX=
DATABASE_URL=
EMAIL_FROM=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=
GEMINI_API_KEY=
GROQ_API_KEY=
