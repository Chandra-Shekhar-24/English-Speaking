# Copy this file to ".env" and fill in real values.

# --- Required: AI ---
# Get a free key (no credit card) at: https://console.groq.com
GROQ_API_KEY=your_api_key_here

# --- Required: PostgreSQL (accounts, login, permanent User IDs) ---
# Any managed Postgres works: Neon, Supabase, Render Postgres, Railway, RDS...
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Most managed providers require ?sslmode=require at the end.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# --- Optional: outgoing email for "forgot password" links ---
# Without this set, reset links are printed to the server console
# instead (fine for local development, not for real users).
# Get a free key at: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com

# --- Optional: auto-sync every user account into a Google Sheet ---
# See README.md for the full step-by-step setup. Leave blank to
# disable — the app works fully without this.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Users

# --- Optional: lets you delete any user's account via a protected
# admin API route (DELETE /api/admin/users/:userCode). Pick any long
# random string. Leave blank to disable that route entirely.
ADMIN_SECRET=

# --- Required for production: your deployed URL ---
# Used to build password-reset links and lock down CORS/cookies.
# Example: https://english-passport.onrender.com
APP_URL=https://english-speaking-g7dn.onrender.com

# --- Optional ---
PORT=3000
NODE_ENV=development
DATABASE_POOL_MAX=10
